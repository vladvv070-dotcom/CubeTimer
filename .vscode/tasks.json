{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Next Cube Pro local server",
            "type": "process",
            "command": "C:\\Users\\admin\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\python\\python.exe",
            "args": [
                "-u",
                "-m",
                "http.server",
                "4173",
                "--bind",
                "127.0.0.1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "next-cube-pro",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Serving HTTP on",
                    "endsPattern": "Serving HTTP on"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": false
            }
        }
    ]
}
